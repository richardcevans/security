#cloud-config
write_files:
  - path: /home/opc/.deep-sec-genai-defaults
    owner: opc:opc
    permissions: '0600'
    content: |
      # Generated by the Deep Sec Terraform deployment. Contains no credentials.
      OCI_REGION="${region}"
      GENAI_COMPARTMENT_OCID="${genai_compartment_ocid}"
      GENAI_MODEL_ID="${genai_model_id}"
  - path: /home/opc/.deep-sec-lab-password
    owner: opc:opc
    permissions: '0600'
    content: |
      ${jupyter_password}
  - path: /home/opc/.deep-sec-lab-environment
    owner: opc:opc
    permissions: '0600'
    content: |
      # Generated by the Deep Sec Terraform deployment. Do not add to source control.
      export LAB_PWD='${jupyter_password}'
      export TNS_ADMIN="$HOME/deep-sec-wallet/tns_admin"
  - path: /home/opc/.deep-sec-wallet-download-url
    owner: opc:opc
    permissions: '0600'
    content: |
      ${wallet_par_url}
  - path: /home/opc/.deep-sec-jupyter-terminal-title.sh
    owner: opc:opc
    permissions: '0644'
    content: |
      # Jupyter may source .bashrc more than once for one terminal. Assign one
      # title per shell, not once per .bashrc evaluation.
      if [[ -n "$${JUPYTER_SERVER_ROOT:-}" && -n "$${PS1:-}" && -z "$${DEEPSEC_JUPYTER_TERMINAL_TITLE_ASSIGNED:-}" ]]; then
        export DEEPSEC_JUPYTER_TERMINAL_TITLE_ASSIGNED=1
        STATE=/tmp/.deep-sec-jupyter-terminal-count
        LOCK=/tmp/.deep-sec-jupyter-terminal-count.lock

        {
          flock 9

          terminal_count=0
          if [[ -f "$STATE" ]]; then
            read -r terminal_count < "$STATE" || terminal_count=0
          fi
          terminal_count=$((terminal_count + 1))
          printf '%s\n' "$terminal_count" > "$STATE"

          case "$terminal_count" in
            1) JUPYTER_TERMINAL_TITLE="Terminal A" ;;
            2) JUPYTER_TERMINAL_TITLE="Terminal B" ;;
            *) JUPYTER_TERMINAL_TITLE="Terminal $terminal_count" ;;
          esac
        } 9>"$LOCK"

        PS1="$${PS1}\[\033]0;$${JUPYTER_TERMINAL_TITLE}\007\]"
      fi
  - path: /home/opc/reset_deep-sec_terminal_titles.sh
    owner: opc:opc
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      rm -fv /tmp/.deep-sec-jupyter-terminal-count \
        /tmp/.deep-sec-jupyter-terminal-count.lock
      echo "Terminal titles reset. Close existing Jupyter terminals, then open Terminal A followed by Terminal B."
  - path: /usr/local/sbin/configure-deep-sec-jupyter-terminal-titles
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      bashrc=/home/opc/.bashrc
      title_source_line='[[ -f /home/opc/.deep-sec-jupyter-terminal-title.sh ]] && source /home/opc/.deep-sec-jupyter-terminal-title.sh'
      password_source_line='[[ -r /home/opc/.deep-sec-lab-password ]] && export LAB_PWD="$(< /home/opc/.deep-sec-lab-password)"'
      environment_source_line='[[ -r /home/opc/.deep-sec-lab-environment ]] && source /home/opc/.deep-sec-lab-environment'

      touch "$bashrc"
      if ! grep -Fqx "$title_source_line" "$bashrc"; then
        printf '\n# Deep Sec labels Jupyter terminals in opening order.\n%s\n' "$title_source_line" >> "$bashrc"
      fi
      if ! grep -Fqx "$password_source_line" "$bashrc"; then
        printf '# Deep Sec loads the generated disposable lab password for terminal use.\n%s\n' "$password_source_line" >> "$bashrc"
      fi
      if ! grep -Fqx "$environment_source_line" "$bashrc"; then
        printf '# Deep Sec loads the database connection environment for terminal use.\n%s\n' "$environment_source_line" >> "$bashrc"
      fi
      chown opc:opc "$bashrc"
      chmod 0644 "$bashrc"
      rm -fv /tmp/.deep-sec-jupyter-terminal-count \
        /tmp/.deep-sec-jupyter-terminal-count.lock
      echo "Deep Sec Jupyter terminal titles are configured."
  - path: /usr/local/sbin/download-deep-sec-lab-files
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc

      download_file() {
        local destination="$1"
        local source_url="$2"
        local temporary="$${destination}.part"
        local attempt

        rm -fv "$temporary"
        for attempt in 1 2 3; do
          echo "Downloading $source_url to $destination (attempt $attempt of 3)"
          if runuser -u opc -- wget --https-only --timeout=30 --tries=1 --progress=bar:force -O "$temporary" "$source_url" && \
             [[ -s "$temporary" ]] && unzip -tqq "$temporary"; then
            mv -v "$temporary" "$destination"
            return 0
          fi
          rm -fv "$temporary"
          echo "Download attempt $attempt failed." >&2
        done

        echo "Could not download $source_url after three attempts." >&2
        return 1
      }

      download_file \
        "$home_dir/deep-data-security-flask-app.zip" \
        "https://objectstorage.us-ashburn-1.oraclecloud.com/p/Mzf75vY1KZat2TyYinBCgXRxO0q8Ky-adubY5hAAHj21tjcSBowCcJcHkBw6Glh5/n/oradbclouducm/b/dbsec_public/o/deep-data-security-flask-app.zip"
      download_file \
        "$home_dir/vibe-cli.zip" \
        "https://objectstorage.us-ashburn-1.oraclecloud.com/p/upjEj2B-bJEiS_xADUEav8LhFQYxF7eDpo3FeqRF3SgxEAYEguOGKAVhBFujxsiP/n/oradbclouducm/b/dbsec_public/o/vibe-cli.zip"

      echo "Deep Sec lab files are ready in $home_dir."
  - path: /usr/local/sbin/download-deep-sec-wallet
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      wallet_url_file="$home_dir/.deep-sec-wallet-download-url"
      wallet_archive="$home_dir/.deep-sec-wallet.zip"
      wallet_directory="$home_dir/deep-sec-wallet/tns_admin"
      temporary_archive="$${wallet_archive}.part"

      [[ -s "$wallet_url_file" ]] || {
        echo "Deep Sec wallet download URL is missing or empty." >&2
        exit 1
      }
      wallet_url=$(< "$wallet_url_file")

      rm -fv "$temporary_archive" "$wallet_archive"
      for attempt in 1 2 3; do
        echo "Downloading the generated ADB wallet (attempt $attempt of 3)"
        if runuser -u opc -- wget --https-only --timeout=30 --tries=1 --progress=bar:force -O "$temporary_archive" "$wallet_url" && \
           [[ -s "$temporary_archive" ]] && unzip -tqq "$temporary_archive"; then
          mv -v "$temporary_archive" "$wallet_archive"
          break
        fi
        rm -fv "$temporary_archive"
        if [[ "$attempt" == 3 ]]; then
          echo "Could not download the generated ADB wallet after three attempts." >&2
          exit 1
        fi
      done

      rm -rfv "$wallet_directory"
      mkdir -pv "$wallet_directory"
      unzip -q "$wallet_archive" -d "$wallet_directory"
      for required_file in cwallet.sso ewallet.p12 sqlnet.ora tnsnames.ora; do
        [[ -s "$wallet_directory/$required_file" ]] || {
          echo "Downloaded wallet is missing $required_file." >&2
          exit 1
        }
      done
      # OCI wallet archives use the Instant Client default (?/network/admin).
      # This VM keeps its generated wallet in a protected per-lab directory.
      escaped_wallet_directory=$(printf '%s' "$wallet_directory" | sed 's/[&|\\]/\\&/g')
      sed -i "s|DIRECTORY=\"?/network/admin\"|DIRECTORY=\"$escaped_wallet_directory\"|g" "$wallet_directory/sqlnet.ora"
      grep -F "DIRECTORY=\"$wallet_directory\"" "$wallet_directory/sqlnet.ora" >/dev/null || {
        echo "Wallet sqlnet.ora does not point to $wallet_directory." >&2
        exit 1
      }
      chown -R opc:opc "$wallet_directory"
      chmod 0700 "$wallet_directory"
      find "$wallet_directory" -type f -exec chmod 0600 {} +
      rm -fv "$wallet_archive" "$wallet_url_file"
      echo "Deep Sec ADB wallet is ready at $wallet_directory."
  - path: /usr/local/sbin/configure-deep-sec-jupyter-password
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      password_file=/home/opc/.deep-sec-lab-password
      config_dir=/home/opc/.jupyter
      config_file="$config_dir/jupyter_server_config.py"
      jupyter_python=/opt/jupyter/bin/python
      jupyter_service=jupyter-opc.service

      [[ -s "$password_file" ]] || {
        echo "Deep Sec Jupyter password file is missing or empty." >&2
        exit 1
      }
      [[ -x "$jupyter_python" ]] || {
        echo "Expected Jupyter Python runtime is missing: $jupyter_python" >&2
        exit 1
      }

      password_hash=$(runuser -u opc -- "$jupyter_python" - "$password_file" <<'PY'
      from pathlib import Path
      import sys

      from jupyter_server.auth import passwd

      print(passwd(Path(sys.argv[1]).read_text(encoding="utf-8").strip()))
      PY
      )

      install -d -m 0700 -o opc -g opc "$config_dir"
      touch "$config_file"
      chown opc:opc "$config_file"
      chmod 0600 "$config_file"
      sed -i '/# BEGIN Deep Sec Terraform password/,/# END Deep Sec Terraform password/d' "$config_file"
      printf '%s\n' \
        '' \
        '# BEGIN Deep Sec Terraform password' \
        '# Generated by the Deep Sec Terraform deployment.' \
        "c.ServerApp.password = u'$password_hash'" \
        '# END Deep Sec Terraform password' \
        >> "$config_file"
      if ! systemctl cat "$jupyter_service" >/dev/null 2>&1; then
        echo "Expected Jupyter service was not found: $jupyter_service" >&2
        exit 1
      fi
      systemctl restart "$jupyter_service"
      echo "Deep Sec Jupyter password configured and $jupyter_service restarted."
  - path: /usr/local/sbin/deep-sec-service-preflight
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Runs as the application service user before Gunicorn starts. It produces
      # a precise journal error for the common boot-order and wallet problems.
      set -Eeuo pipefail

      service_name="$1"
      case "$service_name" in
        admin)
          app_dir=/opt/deep-sec-admin-console
          python_bin="$app_dir/.venv/bin/python"
          app_file="$app_dir/admin_app.py"
          ;;
        customer)
          app_dir=/opt/deep-sec-customer-sales
          python_bin="$app_dir/.venv/bin/python"
          app_file="$app_dir/app.py"
          ;;
        *)
          echo "Unknown Deep Sec service name: $service_name" >&2
          exit 2
          ;;
      esac

      [[ -x "$python_bin" ]] || { echo "Missing Python runtime: $python_bin" >&2; exit 1; }
      [[ -r "$app_file" ]] || { echo "Missing application source: $app_file" >&2; exit 1; }
      [[ -n "$${TNS_ADMIN:-}" ]] || { echo 'TNS_ADMIN is not set in the service environment.' >&2; exit 1; }
      for wallet_file in cwallet.sso ewallet.p12 sqlnet.ora tnsnames.ora; do
        [[ -r "$TNS_ADMIN/$wallet_file" ]] || {
          echo "Wallet prerequisite missing or unreadable: $TNS_ADMIN/$wallet_file" >&2
          exit 1
        }
      done
      echo "Deep Sec $service_name preflight passed: app=$app_file tns_admin=$TNS_ADMIN"
  - path: /usr/local/sbin/deep-sec-wait-for-http
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      port="$1"
      name="$2"
      for attempt in $(seq 1 30); do
        if curl --fail --silent --show-error --max-time 2 "http://127.0.0.1:$port/healthz"; then
          echo "Deep Sec $name health endpoint is ready on port $port."
          exit 0
        fi
        sleep 1
      done
      echo "Deep Sec $name did not become healthy on port $port within 30 seconds." >&2
      exit 1
  - path: /usr/local/sbin/deep-sec-status
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # One command for handoff support on these disposable training VMs.
      set -u

      status=0
      show_service() {
        local service="$1"
        local port="$2"
        printf '\n===== %s =====\n' "$service"
        systemctl status "$service" --no-pager -l || status=1
        printf '\nHealth endpoint: '
        if curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:$port/healthz"; then
          printf '\n'
        else
          printf '\n'
          status=1
        fi
        printf '\nRecent journal entries:\n'
        journalctl -u "$service" -b -n 100 --no-pager -o short-iso || status=1
      }

      printf '===== Deep Sec bootstrap =====\n'
      cloud-init status --long || status=1
      [[ -f /var/log/deep-sec-bootstrap.log ]] && {
        printf '\nRecent bootstrap log:\n'
        tail -n 100 /var/log/deep-sec-bootstrap.log
      }
      printf '\n===== Listening sockets =====\n'
      ss -ltnp '( sport = :7777 or sport = :7778 or sport = :8888 )' || status=1
      show_service deep-sec-admin-console.service 7778
      show_service deep-sec-customer-sales.service 7777
      exit "$status"
  - path: /usr/local/sbin/bootstrap-deep-sec
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Cloud-init invokes this one orchestrator so every phase has timestamped,
      # durable output in both /var/log and the system journal.
      set -Eeuo pipefail

      log_file=/var/log/deep-sec-bootstrap.log
      state_dir=/var/lib/deep-sec
      status_file="$state_dir/bootstrap-status"
      install -d -m 0755 "$state_dir"
      touch "$log_file"
      chmod 0644 "$log_file"
      exec > >(tee -a "$log_file" | logger -t deep-sec-bootstrap) 2>&1

      timestamp() { date --iso-8601=seconds; }
      phase() { printf '\n[%s] ===== %s =====\n' "$(timestamp)" "$1"; }
      failed() {
        local exit_code="$1"
        printf '[%s] FAILED: bootstrap exited with status %s\n' "$(timestamp)" "$exit_code"
        printf 'FAILED %s exit_code=%s\n' "$(timestamp)" "$exit_code" > "$status_file"
        /usr/local/sbin/deep-sec-status || true
        exit "$exit_code"
      }
      trap 'failed $?' ERR

      printf 'RUNNING %s\n' "$(timestamp)" > "$status_file"
      phase 'Configure Jupyter terminal environment'
      /usr/local/sbin/configure-deep-sec-jupyter-terminal-titles
      phase 'Download and validate generated ADB wallet'
      /usr/local/sbin/download-deep-sec-wallet
      phase 'Configure Jupyter password'
      /usr/local/sbin/configure-deep-sec-jupyter-password
      phase 'Download and validate application packages'
      /usr/local/sbin/download-deep-sec-lab-files
      phase 'Install and start Deep Sec applications'
      /usr/local/sbin/install-deep-sec-admin-console
      phase 'Install Vibe Coding'
      /usr/local/sbin/install-deep-sec-vibe
      phase 'Verify application services'
      /usr/local/sbin/deep-sec-status
      printf 'COMPLETE %s\n' "$(timestamp)" > "$status_file"
      printf '[%s] Deep Sec bootstrap completed successfully.\n' "$(timestamp)"
  - path: /usr/local/sbin/install-deep-sec-admin-console
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      package_file="$home_dir/deep-data-security-flask-app.zip"
      stage_dir=/var/tmp/deep-sec-admin-console-stage
      admin_dir=/opt/deep-sec-admin-console
      admin_database_dir=/opt/deep-sec-admin-database
      admin_database_stage=/var/tmp/deep-sec-admin-database-stage
      admin_environment_file=/etc/deep-sec/admin-console.env
      admin_service_file=/etc/systemd/system/deep-sec-admin-console.service
      customer_stage_dir=/var/tmp/deep-sec-customer-sales-stage
      customer_dir=/opt/deep-sec-customer-sales
      customer_environment_file=/etc/deep-sec/customer-sales.env
      customer_service_file=/etc/systemd/system/deep-sec-customer-sales.service
      vibe_reload_sudoers=/etc/sudoers.d/deep-sec-vibe-reload
      wallet_dir="$home_dir/deep-sec-wallet/tns_admin"
      customer_wallet_link="$customer_dir/tns_admin"

      [[ -s "$package_file" ]] || { echo "Missing lab package: $package_file" >&2; exit 1; }
      [[ -f "$wallet_dir/tnsnames.ora" ]] || { echo "Missing installed wallet: $wallet_dir" >&2; exit 1; }
      command -v openssl >/dev/null || { echo 'openssl is required for the admin-console session secret.' >&2; exit 1; }

      systemctl stop deep-sec-admin-console.service 2>/dev/null || true
      systemctl stop deep-sec-customer-sales.service 2>/dev/null || true
      rm -rfv "$stage_dir" "$admin_dir"
      mkdir -pv "$stage_dir"
      unzip -q "$package_file" 'admin-app/*' -d "$stage_dir"
      mv -v "$stage_dir/admin-app" "$admin_dir"
      rm -rfv "$stage_dir"
      chown -R opc:opc "$admin_dir"

      runuser -u opc -- /usr/bin/python3 -m venv "$admin_dir/.venv"
      runuser -u opc -- "$admin_dir/.venv/bin/python" -m pip install --disable-pip-version-check --no-input --retries 3 --timeout 30 --upgrade pip
      runuser -u opc -- "$admin_dir/.venv/bin/python" -m pip install --disable-pip-version-check --no-input --retries 3 --timeout 30 -r "$admin_dir/requirements.txt"
      runuser -u opc -- "$admin_dir/.venv/bin/python" -m pip check

      rm -rfv "$admin_database_stage" "$admin_database_dir"
      mkdir -pv "$admin_database_stage"
      unzip -q "$package_file" 'database/*' -d "$admin_database_stage"
      mv -v "$admin_database_stage/database" "$admin_database_dir"
      rm -rfv "$admin_database_stage"
      chown -R opc:opc "$admin_database_dir"

      rm -rfv "$customer_stage_dir" "$customer_dir"
      mkdir -pv "$customer_stage_dir"
      unzip -q "$package_file" 'flask-app/*' -d "$customer_stage_dir"
      mv -v "$customer_stage_dir/flask-app" "$customer_dir"
      rm -rfv "$customer_stage_dir"
      chown -R opc:opc "$customer_dir"
      ln -sfnv "$wallet_dir" "$customer_wallet_link"
      for wallet_file in tnsnames.ora sqlnet.ora cwallet.sso ewallet.p12; do
        [[ -s "$customer_wallet_link/$wallet_file" ]] || {
          echo "Customer Sales wallet link is missing $wallet_file." >&2
          exit 1
        }
      done

      runuser -u opc -- /usr/bin/python3 -m venv "$customer_dir/.venv"
      runuser -u opc -- "$customer_dir/.venv/bin/python" -m pip install --disable-pip-version-check --no-input --retries 3 --timeout 30 --upgrade pip
      runuser -u opc -- "$customer_dir/.venv/bin/python" -m pip install --disable-pip-version-check --no-input --retries 3 --timeout 30 -r "$customer_dir/requirements.txt"
      runuser -u opc -- "$customer_dir/.venv/bin/python" -m pip check

      install -d -m 0755 /etc/deep-sec
      umask 077
      admin_secret=$(openssl rand -hex 32)
      customer_secret=$(openssl rand -hex 32)
      printf '%s\n' \
        '# Generated by the Deep Sec Terraform deployment. Keep this file private.' \
        'ADMIN_FLASK_HOST=0.0.0.0' \
        'ADMIN_FLASK_PORT=7778' \
        'ADMIN_LOG_LEVEL=DEBUG' \
        'PYTHONUNBUFFERED=1' \
        'PYTHONDONTWRITEBYTECODE=1' \
        "ADMIN_FLASK_SECRET_KEY=$admin_secret" \
        'ADMIN_DB_DSN=${adb_service_alias}' \
        "ADMIN_WALLET_LOCATION=$wallet_dir" \
        "TNS_ADMIN=$wallet_dir" \
        "DEEP_SEC_DATABASE_DIR=$admin_database_dir" \
        'ADMIN_VIBE_EXECUTABLE=/opt/deep-sec-vibe/bin/vibe' \
        "ADMIN_VIBE_PROJECT_ROOT=$customer_dir" \
        'VIBE_HOME=/opt/deep-sec-vibe/home' \
        'VIBE_CONFIG=/opt/deep-sec-vibe/config/config.toml' \
        'VIBE_LAB_CONTEXT=/opt/deep-sec-vibe/home/lab-context.md' \
        > "$admin_environment_file"
      chown root:root "$admin_environment_file"
      chmod 0600 "$admin_environment_file"
      printf '%s\n' \
        '# Generated by the Deep Sec Terraform deployment. Keep this file private.' \
        'FLASK_HOST=0.0.0.0' \
        'FLASK_PORT=7777' \
        'FLASK_DEBUG=false' \
        'FLASK_LOG_LEVEL=DEBUG' \
        'PYTHONUNBUFFERED=1' \
        'PYTHONDONTWRITEBYTECODE=1' \
        "FLASK_SECRET_KEY=$customer_secret" \
        'DB_DSN=${adb_service_alias}' \
        'DB_SCHEMA=APPLAB' \
        "DB_WALLET_LOCATION=$customer_wallet_link" \
        "TNS_ADMIN=$customer_wallet_link" \
        "GENAI_DEFAULTS_FILE=$home_dir/.deep-sec-genai-defaults" \
        > "$customer_environment_file"
      chown root:root "$customer_environment_file"
      chmod 0600 "$customer_environment_file"
      restorecon -RFv "$admin_dir" "$admin_database_dir" "$customer_dir" /etc/deep-sec

      cat > "$admin_service_file" <<'SERVICE'
      [Unit]
      Description=Deep Sec Administrator Console
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0
      StartLimitBurst=0

      [Service]
      Type=simple
      User=opc
      Group=opc
      WorkingDirectory=/opt/deep-sec-admin-console
      EnvironmentFile=/etc/deep-sec/admin-console.env
      ExecStartPre=/usr/local/sbin/deep-sec-service-preflight admin
      ExecStart=/opt/deep-sec-admin-console/.venv/bin/python -m gunicorn --bind 0.0.0.0:7778 --workers 1 --worker-class gthread --threads 4 --timeout 120 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --log-level debug --capture-output --access-logfile - --error-logfile - admin_app:app
      ExecStartPost=/usr/local/sbin/deep-sec-wait-for-http 7778 admin-console
      Restart=always
      RestartSec=3
      TimeoutStartSec=180
      TimeoutStopSec=30
      SyslogIdentifier=deep-sec-admin-console
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
      SERVICE

      cat > "$customer_service_file" <<'SERVICE'
      [Unit]
      Description=Deep Sec Customer Sales Application
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0
      StartLimitBurst=0

      [Service]
      Type=simple
      User=opc
      Group=opc
      WorkingDirectory=/opt/deep-sec-customer-sales
      EnvironmentFile=/etc/deep-sec/customer-sales.env
      ExecStartPre=/usr/local/sbin/deep-sec-service-preflight customer
      ExecStart=/opt/deep-sec-customer-sales/.venv/bin/python -m gunicorn --bind 0.0.0.0:7777 --workers 1 --worker-class gthread --threads 4 --timeout 120 --graceful-timeout 30 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --log-level debug --capture-output --access-logfile - --error-logfile - app:app
      ExecStartPost=/usr/local/sbin/deep-sec-wait-for-http 7777 customer-sales
      ExecReload=/bin/kill -HUP $MAINPID
      Restart=always
      RestartSec=3
      TimeoutStartSec=180
      TimeoutStopSec=30
      SyslogIdentifier=deep-sec-customer-sales
      StandardOutput=journal
      StandardError=journal

      [Install]
      WantedBy=multi-user.target
      SERVICE

      if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
        firewall-cmd --permanent --add-port=7777/tcp
        firewall-cmd --permanent --add-port=7778/tcp
        firewall-cmd --reload
      fi
      systemd-analyze verify "$admin_service_file" "$customer_service_file"
      printf '%s\n' 'opc ALL=(root) NOPASSWD: /usr/bin/systemctl reload deep-sec-customer-sales.service' > "$vibe_reload_sudoers"
      chmod 0440 "$vibe_reload_sudoers"
      visudo -cf "$vibe_reload_sudoers"
      systemctl daemon-reload
      systemctl enable --now deep-sec-customer-sales.service
      systemctl enable --now deep-sec-admin-console.service
      echo "Deep Sec Customer Sales Application is running on port 7777."
      echo "Deep Sec Administrator Console is running on port 7778."
  - path: /usr/local/sbin/install-deep-sec-vibe
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      home_dir=/home/opc
      archive="$home_dir/vibe-cli.zip"
      source_dir="$home_dir/vibe-cli"
      vibe_base=/opt/deep-sec-vibe
      vibe_home="$vibe_base/home"
      vibe_bin_dir="$vibe_base/bin"
      vibe_config_dir="$vibe_base/config"
      customer_dir=/opt/deep-sec-customer-sales

      [[ -s "$archive" ]] || { echo "Missing Vibe package: $archive" >&2; exit 1; }
      [[ -d "$customer_dir" ]] || { echo "Customer Sales application is missing: $customer_dir" >&2; exit 1; }
      unzip -tqq "$archive"
      rm -rfv "$source_dir" "$vibe_base"
      mkdir -pv "$source_dir" "$vibe_base"
      unzip -q "$archive" -d "$source_dir"
      chown -R opc:opc "$source_dir" "$vibe_base"
      runuser -u opc -- env \
        VIBE_HOME="$vibe_home" \
        VIBE_BIN_DIR="$vibe_bin_dir" \
        VIBE_CONFIG_DIR="$vibe_config_dir" \
        bash -c 'cd /home/opc/vibe-cli && ./install.sh --overwrite-config'
      restorecon -RFv "$vibe_base"
      runuser -u opc -- env \
        VIBE_HOME="$vibe_home" \
        VIBE_CONFIG="$vibe_config_dir/config.toml" \
        VIBE_LAB_CONTEXT="$vibe_home/lab-context.md" \
        "$vibe_bin_dir/vibe" --project "$customer_dir" status
      echo "Vibe Coding is ready for the Deep Sec Admin Console."
runcmd:
  - [ /usr/local/sbin/bootstrap-deep-sec ]
