#cloud-config
write_files:
  - path: /home/opc/.deepsec9-genai-defaults
    owner: opc:opc
    permissions: '0600'
    content: |
      # Generated by the DeepSec9 Terraform deployment. Contains no credentials.
      OCI_REGION="${region}"
      GENAI_COMPARTMENT_OCID="${genai_compartment_ocid}"
      GENAI_MODEL_ID="${genai_model_id}"
