# Sanitized runtime template for the two-agent Entra ID demonstration.

# OCI Generative AI
OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_PROFILE=DEFAULT
OCI_AUTH_TYPE=API_KEY
OCI_GENAI_SERVICE_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
COMPARTMENT_ID=
MODEL_CHOICE=
MODEL_ID=
MAX_TOKENS=4096

# Oracle Database and TCPS wallet
DB_USER=
DB_PASSWORD=
DB_DSN=
SSL_CONFIG_DIR=/absolute/path/to/sslserver
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_POOL_INCREMENT=1

# HR Entra application and downstream database resource
DB_CLIENT_ID=
DB_CLIENT_CREDENTIAL=
DB_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
DB_SCOPES=

# Compensation Entra application and downstream database resource
COMP_DB_CLIENT_ID=
COMP_DB_CLIENT_CREDENTIAL=
COMP_DB_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
COMP_DB_SCOPES=

# Interactive Entra client
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SCOPES=
COMP_AZURE_SCOPES=
