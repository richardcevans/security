# Sanitized template. 00_setup_adb.sh normally writes the real .env.

DB_USER=
DB_PASSWORD=
DB_DSN=
SSL_CONFIG_DIR=/absolute/path/to/extracted/wallet
WALLET_PWD=

OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_PROFILE=DEFAULT
OCI_CLI_AUTH=
OCI_AUTH_TYPE=API_KEY
COMPARTMENT_ID=
MODEL_ID=
MODEL_PROVIDER=
OCI_GENAI_SERVICE_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
MAX_TOKENS=4096

HR_OCI_DOMAIN_URL=https://idcs-<domain>.identity.oraclecloud.com:443
HR_DB_APP_ID=
HR_DB_CLIENT_ID=
HR_DB_CLIENT_SECRET=
HR_DB_SCOPE=
HR_MIDTIER_APP_ID=
HR_MIDTIER_CLIENT_ID=
HR_MIDTIER_CLIENT_SECRET=
HR_MIDTIER_SCOPE=
HR_LOGIN_APP_ID=
HR_LOGIN_CLIENT_ID=
HR_LOGIN_CLIENT_SECRET=
HR_APP_CLIENT_ID=
HR_APP_CLIENT_SECRET=
HR_APP_SCOPE=
HR_REDIRECT_URI=http://localhost:8888/callback
