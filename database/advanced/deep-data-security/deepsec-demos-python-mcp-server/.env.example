# Sanitized runtime template. Never put secrets in this file.

# Database and Deep Data Security
DB_USER=
DB_PASSWORD=
DB_DSN=
SSL_CONFIG_DIR=/absolute/path/to/extracted/wallet
WALLET_PWD=
WALLET_PASSWORD=
DEFAULT_SCHEMA=HR
DB_CLIENT_ID=
DB_CLIENT_SECRET=
DB_SCOPE=

# OCI IAM browser login
OCI_DOMAIN_URL=https://idcs-<domain>.identity.oraclecloud.com:443
APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_SCOPE=
REDIRECT_URI=http://localhost:8888/callback

# MCP protected resource and token introspection
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_AUTHORIZATION_SERVER_URL=https://idcs-<domain>.identity.oraclecloud.com:443
MCP_TOKEN_ISSUER=https://identity.oraclecloud.com/
MCP_AUTH_AUDIENCE=
MCP_REQUIRED_SCOPES=
MCP_INTROSPECTION_URL=
MCP_INTROSPECTION_CLIENT_ID=
MCP_INTROSPECTION_CLIENT_SECRET=

# OCI Generative AI companion client
OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_PROFILE=DEFAULT
OCI_IAM_CA_BUNDLE=
END_USER_ACCESS_TOKEN=
GENAI_AUTH_TYPE=api_key
COMPARTMENT_ID=
MODEL_ID=
OCI_GENAI_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
