# Template for the CLI's non-secret runtime configuration.

# Oracle DB connection
DB_USER=
DB_PASSWORD=
DB_DSN=
SSL_CONFIG_DIR=

# OCI IAM browser-login application
OCI_DOMAIN_URL=https://idcs-<domain>.identity.oraclecloud.com:443
APP_CLIENT_ID=
APP_CLIENT_SECRET=
APP_SCOPE=
REDIRECT_URI=http://localhost:8888/callback

# OCI IAM database-access client / Deep Data Security
DB_CLIENT_ID=
DB_CLIENT_SECRET=
DB_SCOPE=
WALLET_PWD=
WALLET_PASSWORD=
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_POOL_INCREMENT=1

# Select AI objects shared with the Deep Sec data roles. Leaving either owner
# blank makes the application use DB_USER.
SELECT_AI_PROFILE_NAME=HR_PROFILE
SELECT_AI_PROFILE_OWNER=
SELECT_AI_TEAM_NAME=HR_TEAM
SELECT_AI_TEAM_OWNER=

# Optional enterprise TLS CA bundles for OCI IAM requests
TLS_CA_BUNDLE=
SSL_CERT_FILE=
