# Copy this file to a private local configuration before running the application.
# Never commit actual passwords, client secrets, wallets, or private API keys.

# -----------------------------------------------------------------------------
# OCI Generative AI
# -----------------------------------------------------------------------------
OCI_CONFIG_FILE=/absolute/path/to/.oci/config
OCI_PROFILE=<oci_api_key_profile_name>
COMPARTMENT_ID=<oci_compartment_ocid>
MODEL_ID=<oci_generative_ai_model_ocid>
OCI_GENAI_ENDPOINT=https://inference.generativeai.<oci_region>.oci.oraclecloud.com
MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Database connection pool
# -----------------------------------------------------------------------------
DB_USER=<database_connection_pool_user>
DB_PASSWORD=<database_connection_pool_password>
DB_DSN=<adb_wallet_tns_alias>
SSL_CONFIG_DIR=/absolute/path/to/extracted/adb_wallet
WALLET_PWD=<adb_wallet_password>

# Optional connection-pool settings.
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_POOL_INCREMENT=1

# -----------------------------------------------------------------------------
# HR mode
# -----------------------------------------------------------------------------
# Database resource application
HR_OCI_DOMAIN_URL=https://idcs-<identity_domain_id>.identity.oraclecloud.com:443
HR_DB_APP_ID=<database_resource_application_id>
HR_DB_SCOPE=<database_access_scope_fqs>

# HR Midtier application: Client Credentials database-token client
HR_DB_CLIENT_ID=<hr_midtier_oauth_client_id>
HR_DB_CLIENT_SECRET=<hr_midtier_oauth_client_secret>

# Browser-login application: Authorization Code client
HR_APP_CLIENT_ID=<browser_login_oauth_client_id>
HR_APP_CLIENT_SECRET=<browser_login_oauth_client_secret>
HR_APP_SCOPE=<hr_agent_access_scope_fqs>
HR_REDIRECT_URI=http://localhost:8888/callback

# -----------------------------------------------------------------------------
# Compensation mode
# -----------------------------------------------------------------------------
# Same database resource application as HR mode
COMP_OCI_DOMAIN_URL=https://idcs-<identity_domain_id>.identity.oraclecloud.com:443
COMP_DB_APP_ID=<database_resource_application_id>
COMP_DB_SCOPE=<database_access_scope_fqs>

# COMPENSATION_AGENT application: Client Credentials database-token client
COMP_DB_CLIENT_ID=<compensation_agent_oauth_client_id>
COMP_DB_CLIENT_SECRET=<compensation_agent_oauth_client_secret>

# Browser-login application: Authorization Code client
COMP_APP_CLIENT_ID=<browser_login_oauth_client_id>
COMP_APP_CLIENT_SECRET=<browser_login_oauth_client_secret>
COMP_APP_SCOPE=<compensation_agent_access_scope_fqs>
COMP_REDIRECT_URI=http://localhost:8889/callback
