# The app loads these OCI IAM values from ../deep-sec-mcp/.deep-sec-mcp.env.
# Set this URI to the publicly registered callback URI for this web app.
WEB_HR_HOST=0.0.0.0
WEB_HR_PORT=8012
WEB_HR_REDIRECT_URI=https://your-public-host:8012/callback

# Uses ADB_SERVICE, TNS_ADMIN/WALLET_DIR, and WALLET_PWD from the lab environment.
WEB_HR_TNS_ALIAS=
